# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/zomato_bot

# Zomato MCP (HTTP)
ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp
# OAuth: when Zomato requires per-user tokens, set client id/secret and store tokens per session
# ZOMATO_OAUTH_CLIENT_ID=
# ZOMATO_OAUTH_CLIENT_SECRET=

# OpenAI — intent recognition and natural language (optional; falls back to rule-based if unset)
OPENAI_API_KEY=sk-...

# Telegram bot (for npm run dev:telegram / npm run telegram)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Use either GEMINI_CLI_PATH (Gemini CLI = Zomato MCP via whitelisted client) or BACKEND_URL (API backend).
# GEMINI_CLI_PATH=gemini
# Or: GEMINI_CLI_PATH=npx   (uses npx @google/gemini-cli)
# BACKEND_URL=http://localhost:3000

# Optional: API key for server-to-server auth (e.g. Telegram webhook verifier)
# API_KEY=
