{
  "name": "zomato-tg-bot",
  "version": "0.1.0",
  "description": "API-first Node.js backend for Zomato food ordering via natural language (Telegram, Web)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "telegram": "node dist/telegram/index.js",
    "dev:telegram": "tsx watch src/telegram/index.ts",
    "postinstall": "node scripts/fix-node-pty-mac.cjs",
    "db:migrate": "node -e \"require('fs').readdirSync('src/db/migrations').filter(f=>f.endsWith('.sql')).forEach(f=>console.log(f))\"",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "dotenv": "^17.2.3",
    "fastify": "4.29.1",
    "node-pty": "^1.1.0",
    "openai": "^4.73.0",
    "pg": "^8.13.0",
    "telegraf": "^4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
